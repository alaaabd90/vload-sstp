#!/usr/bin/env bash
# sstp - manage vload-sstp (accel-ppp SSTP servers behind an SNI router)
#
# Interactive menu:   sstp
# Scriptable:         sstp list | status | enable | disable
#                     sstp add <name> <sni> <port> [user] [password]
#                     sstp set <name> [sni=X] [port=N] [user=U] [pass=P]
#                     sstp remove <name>
#                     sstp show <name>            (MikroTik commands)
#                     sstp socks <host> <port>    (SOCKS5 proxy for client traffic)
#                     sstp egress socks|nat
#                     sstp update                 (pull latest repo, keep clients)
#                     sstp uninstall [-y]
set -euo pipefail

PREFIX=/opt/vload-sstp
CONF_DIR=/etc/vload-sstp
CLIENTS="$CONF_DIR/clients"
GLOBAL="$CONF_DIR/vload-sstp.conf"
ENABLED_FLAG="$CONF_DIR/enabled"
LOG_DIR=/var/log/vload-sstp
ACCEL="$PREFIX/accel/sbin/accel-pppd"
ACCEL_CMD="$PREFIX/accel/bin/accel-cmd"
HEV="$PREFIX/bin/hev-socks5-tunnel"
TUN=vsstp-egress
REPO_TARBALL=https://codeload.github.com/alaaabd90/vload-sstp/tar.gz/refs/heads/main

c_ok()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
c_err() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
c_hdr() { printf '\033[1;36m%s\033[0m\n' "$*"; }
die()   { c_err "ERROR: $*"; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "run as root"; }
installed() { [ -x "$ACCEL" ]; }

load_global() {
    EGRESS_MODE=socks; SOCKS_HOST=127.0.0.1; SOCKS_PORT=2063
    POOL_PREFIX=10.88; EGRESS_TABLE=188; EGRESS_RULE_PRIO=1888
    # shellcheck disable=SC1090
    [ -f "$GLOBAL" ] && . "$GLOBAL"
}

save_global() {
    cat > "$GLOBAL" <<EOF
# vload-sstp global settings
EGRESS_MODE=$EGRESS_MODE
SOCKS_HOST=$SOCKS_HOST
SOCKS_PORT=$SOCKS_PORT
POOL_PREFIX=$POOL_PREFIX
EGRESS_TABLE=$EGRESS_TABLE
EGRESS_RULE_PRIO=$EGRESS_RULE_PRIO
EOF
}

client_names() { [ -d "$CLIENTS" ] && find "$CLIENTS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort || true; }
client_exists() { [ -f "$CLIENTS/$1/client.env" ]; }

load_client() {
    client_exists "$1" || die "no such client: $1"
    # shellcheck disable=SC1090
    . "$CLIENTS/$1/client.env"
}

save_client() {
    cat > "$CLIENTS/$NAME/client.env" <<EOF
NAME=$NAME
SNI=$SNI
PORT=$PORT
CUSER=$CUSER
CPASS='$CPASS'
IDX=$IDX
EOF
    chmod 600 "$CLIENTS/$NAME/client.env"
}

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,15}$ ]]; }
valid_sni()  { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]; }
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_user() { [[ "$1" =~ ^[A-Za-z0-9._@-]{1,32}$ ]]; }
valid_pass() { [[ "$1" =~ ^[A-Za-z0-9._@%+=-]{6,64}$ ]]; }
rand_pass()  { tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 16 || true; }

# port is free if no other client owns it and nothing else listens on it
port_free() {
    local port=$1 self=${2:-} n
    for n in $(client_names); do
        [ "$n" = "$self" ] && continue
        [ "$(. "$CLIENTS/$n/client.env"; echo "$PORT")" = "$port" ] && return 1
    done
    if [ -n "$self" ] && client_exists "$self" && [ "$(. "$CLIENTS/$self/client.env"; echo "$PORT")" = "$port" ]; then
        return 0
    fi
    ! ss -Htln "sport = :$port" | grep -q .
}

next_idx() {
    local i used
    used=" $(for n in $(client_names); do (. "$CLIENTS/$n/client.env"; echo "$IDX"); done | tr '\n' ' ') "
    for i in $(seq 1 250); do
        case "$used" in *" $i "*) ;; *) echo "$i"; return;; esac
    done
    die "no free client slot"
}

gen_cert() {
    local dir=$CLIENTS/$NAME
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -sha256 \
        -subj "/CN=$SNI" -addext "subjectAltName=DNS:$SNI" \
        -keyout "$dir/key.pem" -out "$dir/cert.pem" >/dev/null 2>&1 || die "certificate generation failed"
    chmod 600 "$dir/key.pem"
}

render_client() {
    load_global
    local dir=$CLIENTS/$NAME net="$POOL_PREFIX.$IDX"
    printf '%s * %s *\n' "$CUSER" "$CPASS" > "$dir/chap-secrets"
    chmod 600 "$dir/chap-secrets"
    cat > "$dir/accel-ppp.conf" <<EOF
# generated by vload-sstp for client '$NAME' - edit with the sstp command
[modules]
log_file
sstp
auth_mschap_v2
auth_mschap_v1
auth_chap_md5
auth_pap
chap-secrets
ippool

[core]
log-error=$LOG_DIR/$NAME-core.log
thread-count=2

[common]
single-session=replace

[ppp]
verbose=0
min-mtu=1280
mtu=1400
mru=1400
ipv4=require
ipv6=deny
mppe=allow
lcp-echo-interval=20
lcp-echo-failure=6

[sstp]
verbose=0
accept=ssl
bind=127.0.0.1
port=$PORT
ssl-protocol=tls1.2,tls1.3
ssl-pemfile=$dir/cert.pem
ssl-keyfile=$dir/key.pem
# no host-name: the SNI router already selects this backend, and RouterOS does not
# send the SNI name as the HTTP Host header (host-name would answer 404)
timeout=60
hello-interval=60
ip-pool=$NAME
ifname=vs$IDX-%d

[client-ip-range]
# SSTP connections arrive from the local SNI router (HAProxy) only
127.0.0.0/8

[ip-pool]
gw-ip-address=$net.1
$net.2-254,name=$NAME

[dns]
dns1=1.1.1.1
dns2=8.8.8.8

[chap-secrets]
gw-ip-address=$net.1
chap-secrets=$dir/chap-secrets

[log]
log-file=$LOG_DIR/$NAME.log
log-emerg=$LOG_DIR/$NAME-emerg.log
level=3

[cli]
tcp=127.0.0.1:$((2200 + IDX))
EOF
}

is_enabled() { [ -f "$ENABLED_FLAG" ]; }

restart_client() {
    if is_enabled; then
        systemctl enable "vload-sstp@$1.service" >/dev/null 2>&1
        systemctl restart "vload-sstp@$1.service"
    fi
}

vps_ip() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'; }

show_client() {
    load_client "$1"
    local ip; ip=$(vps_ip)
    c_hdr "Client '$NAME'"
    echo "  SNI          : $SNI"
    echo "  local backend: 127.0.0.1:$PORT   (point SNI '$SNI' to it in your SNI router)"
    echo "  user / pass  : $CUSER / $CPASS"
    echo "  client pool  : $(load_global; echo "$POOL_PREFIX.$IDX.0/24")"
    echo
    c_hdr "MikroTik (RouterOS 7):"
    echo "/ip dns static add name=$SNI address=$ip comment=\"vload-sstp $NAME (only if $SNI does not already resolve to the VPS)\""
    echo "/interface sstp-client add name=sstp-$NAME connect-to=$SNI port=443 add-sni=yes user=$CUSER password=$CPASS authentication=mschap2 max-mtu=1400 max-mru=1400 verify-server-certificate=no disabled=no"
}

cmd_list() {
    load_global
    c_hdr "vload-sstp: $(is_enabled && echo ENABLED || echo DISABLED) | egress: $EGRESS_MODE$([ "$EGRESS_MODE" = socks ] && echo " -> $SOCKS_HOST:$SOCKS_PORT")"
    local n st sess
    printf '%-14s %-28s %-6s %-10s %-9s %s\n' NAME SNI PORT USER STATE SESSIONS
    for n in $(client_names); do
        (
            . "$CLIENTS/$n/client.env"
            st=$(systemctl is-active "vload-sstp@$n.service" 2>/dev/null || true)
            sess=$("$ACCEL_CMD" -t 3 -H 127.0.0.1 -p $((2200 + IDX)) show sessions 2>/dev/null | grep -c '|' || true)
            [ "$sess" -gt 0 ] 2>/dev/null && sess=$((sess - 1))
            printf '%-14s %-28s %-6s %-10s %-9s %s\n' "$NAME" "$SNI" "$PORT" "$CUSER" "$st" "${sess:-0}"
        )
    done
    [ -n "$(client_names)" ] || echo "(no clients yet)"
    printf 'egress service: %s\n' "$(systemctl is-active vload-sstp-egress.service 2>/dev/null || true)"
}

cmd_enable() {
    need_root
    touch "$ENABLED_FLAG"
    systemctl enable vload-sstp-egress.service >/dev/null 2>&1
    systemctl restart vload-sstp-egress.service
    local n
    for n in $(client_names); do restart_client "$n"; done
    c_ok "enabled (starts on boot)"
}

cmd_disable() {
    need_root
    local n
    for n in $(client_names); do
        systemctl disable --now "vload-sstp@$n.service" >/dev/null 2>&1 || true
    done
    systemctl disable --now vload-sstp-egress.service >/dev/null 2>&1 || true
    rm -f "$ENABLED_FLAG"
    c_ok "disabled (stopped, will not start on boot)"
}

cmd_add() {
    need_root
    NAME=${1:-}; SNI=${2:-}; PORT=${3:-}; CUSER=${4:-}; CPASS=${5:-}
    valid_name "$NAME" || die "name must be 1-16 chars: a-z 0-9 -"
    client_exists "$NAME" && die "client '$NAME' already exists"
    valid_sni "$SNI" || die "invalid SNI hostname: $SNI"
    valid_port "$PORT" || die "invalid port: $PORT"
    port_free "$PORT" || die "port $PORT is already in use"
    [ -n "$CUSER" ] || CUSER=$NAME
    [ -n "$CPASS" ] || CPASS=$(rand_pass)
    valid_user "$CUSER" || die "invalid user name"
    valid_pass "$CPASS" || die "password: 6-64 chars of A-Z a-z 0-9 . _ @ % + = -"
    IDX=$(next_idx)
    install -d -m 0700 "$CLIENTS/$NAME"
    save_client; gen_cert; render_client
    restart_client "$NAME"
    c_ok "client '$NAME' added"
    show_client "$NAME"
}

cmd_set() {
    need_root
    local name=${1:-}; shift || true
    load_client "$name"
    local kv k v cert=0
    for kv in "$@"; do
        k=${kv%%=*}; v=${kv#*=}
        case "$k" in
            sni)  valid_sni "$v" || die "invalid SNI: $v"; SNI=$v; cert=1;;
            port) valid_port "$v" || die "invalid port: $v"; port_free "$v" "$NAME" || die "port $v is already in use"; PORT=$v;;
            user) valid_user "$v" || die "invalid user"; CUSER=$v;;
            pass) valid_pass "$v" || die "invalid password"; CPASS=$v;;
            *) die "unknown setting '$k' (use sni= port= user= pass=)";;
        esac
    done
    save_client
    [ "$cert" -eq 1 ] && gen_cert
    render_client
    restart_client "$NAME"
    c_ok "client '$NAME' updated"
    show_client "$NAME"
}

cmd_remove() {
    need_root
    load_client "${1:-}"
    systemctl disable --now "vload-sstp@$NAME.service" >/dev/null 2>&1 || true
    rm -rf "${CLIENTS:?}/$NAME"
    rm -f "$LOG_DIR/$NAME.log" "$LOG_DIR/$NAME-core.log" "$LOG_DIR/$NAME-emerg.log"
    c_ok "client '$NAME' removed"
}

socks_reachable() { timeout 3 bash -c "exec 3<>/dev/tcp/$1/$2" 2>/dev/null; }

cmd_socks() {
    need_root
    load_global
    local host=${1:-} port=${2:-}
    [ -n "$host" ] && [ -n "$port" ] || die "usage: sstp socks <host> <port>"
    [[ "$host" =~ ^[A-Za-z0-9.:-]+$ ]] || die "invalid host: $host"
    valid_port "$port" || die "invalid port: $port"
    socks_reachable "$host" "$port" || c_err "warning: nothing answers on $host:$port right now"
    SOCKS_HOST=$host; SOCKS_PORT=$port; EGRESS_MODE=socks
    save_global
    is_enabled && systemctl restart vload-sstp-egress.service
    c_ok "client traffic now goes to SOCKS5 $SOCKS_HOST:$SOCKS_PORT"
}

cmd_egress() {
    need_root
    load_global
    case "${1:-}" in
        socks) EGRESS_MODE=socks;;
        nat)   EGRESS_MODE=nat;;
        *) die "usage: sstp egress socks|nat";;
    esac
    save_global
    is_enabled && systemctl restart vload-sstp-egress.service
    c_ok "egress mode: $EGRESS_MODE$([ "$EGRESS_MODE" = socks ] && echo " -> $SOCKS_HOST:$SOCKS_PORT")"
}

# re-render every client from its saved settings (after an update) and restart what runs
cmd_reapply() {
    need_root
    local n
    for n in $(client_names); do ( load_client "$n"; render_client ); done
    if is_enabled; then
        systemctl restart vload-sstp-egress.service
        for n in $(client_names); do restart_client "$n"; done
    fi
}

cmd_update() {
    need_root
    command -v curl >/dev/null || die "curl is required"
    local tmp; tmp=$(mktemp -d /tmp/vload-sstp-src.XXXXXX)
    c_hdr "downloading the latest vload-sstp"
    curl -fsSL "$REPO_TARBALL" | tar -xz -C "$tmp" --strip-components=1 || { rm -rf "$tmp"; die "download failed"; }
    bash "$tmp/install.sh" || { rm -rf "$tmp"; die "update failed (the previous version keeps running)"; }
    rm -rf "$tmp"
    c_ok "updated"
}

cmd_uninstall() {
    need_root
    if [ "${1:-}" != "-y" ]; then
        read -r -p "Remove vload-sstp, all clients and certificates? Type YES: " a
        [ "$a" = "YES" ] || { echo "cancelled"; return; }
    fi
    local n
    for n in $(client_names); do systemctl disable --now "vload-sstp@$n.service" >/dev/null 2>&1 || true; done
    systemctl disable --now vload-sstp-egress.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/vload-sstp@.service /etc/systemd/system/vload-sstp-egress.service
    systemctl daemon-reload
    rm -f /usr/local/bin/sstp /etc/modules-load.d/vload-sstp.conf /etc/logrotate.d/vload-sstp
    rm -rf "$CONF_DIR" "$LOG_DIR" "$PREFIX"
    c_ok "vload-sstp uninstalled (build packages such as cmake were left installed)"
}

# ---- internal: used by vload-sstp-egress.service ----
egress_down() {
    load_global
    while ip rule del from "$POOL_PREFIX.0.0/16" lookup "$EGRESS_TABLE" priority "$EGRESS_RULE_PRIO" 2>/dev/null; do :; done
    while ip rule del to "$POOL_PREFIX.0.0/16" lookup main priority "$((EGRESS_RULE_PRIO - 1))" 2>/dev/null; do :; done
    ip route flush table "$EGRESS_TABLE" 2>/dev/null || true
    local wan; wan=$(ip -4 route show default | awk '{print $5; exit}')
    while iptables -t nat -D POSTROUTING -s "$POOL_PREFIX.0.0/16" -o "$wan" -m comment --comment vload-sstp -j MASQUERADE 2>/dev/null; do :; done
}

egress_run() {
    load_global
    # old rules were already removed by ExecStartPre (_egress-down); cleaning here would race
    # with ExecStartPost (_egress-up), which systemd starts right after this process
    if [ "$EGRESS_MODE" = nat ]; then
        local wan; wan=$(ip -4 route show default | awk '{print $5; exit}')
        iptables -t nat -A POSTROUTING -s "$POOL_PREFIX.0.0/16" -o "$wan" -m comment --comment vload-sstp -j MASQUERADE
        exec sleep infinity
    fi
    cat > "$CONF_DIR/hev.yml" <<EOF
tunnel:
  name: $TUN
  mtu: 8500
  multi-queue: false
  ipv4: 198.18.0.1
socks5:
  port: $SOCKS_PORT
  address: $SOCKS_HOST
  udp: 'udp'
misc:
  log-level: warn
EOF
    exec "$HEV" "$CONF_DIR/hev.yml"
}

egress_up() {
    load_global
    [ "$EGRESS_MODE" = socks ] || return 0
    local i
    for i in $(seq 1 50); do ip link show "$TUN" >/dev/null 2>&1 && break; sleep 0.2; done
    ip link show "$TUN" >/dev/null 2>&1 || die "egress tunnel $TUN did not appear"
    ip link set "$TUN" up
    ip route replace default dev "$TUN" table "$EGRESS_TABLE"
    ip rule show | grep -q "from $POOL_PREFIX.0.0/16 lookup $EGRESS_TABLE" || \
        ip rule add from "$POOL_PREFIX.0.0/16" lookup "$EGRESS_TABLE" priority "$EGRESS_RULE_PRIO"
}

# ---- interactive menu ----
ask() { local p=$1 d=${2:-} a; read -r -p "$p${d:+ [$d]}: " a; echo "${a:-$d}"; }

pick_client() {
    local names; mapfile -t names < <(client_names)
    [ "${#names[@]}" -gt 0 ] || { c_err "no clients"; return 1; }
    local i=1 n; for n in "${names[@]}"; do echo "  $i) $n"; i=$((i + 1)); done
    local c; c=$(ask "choose client number")
    [[ "$c" =~ ^[0-9]+$ ]] && [ "$c" -ge 1 ] && [ "$c" -le "${#names[@]}" ] || { c_err "invalid choice"; return 1; }
    echo "${names[$((c - 1))]}"
}

suggest_port() { local p=449; while ! port_free "$p"; do p=$((p + 1)); done; echo "$p"; }

menu() {
    need_root
    while true; do
        echo; cmd_list; echo
        c_hdr " 1) Enable            2) Disable            3) Add new client     4) Remove client"
        c_hdr " 5) Adjust client     6) MikroTik commands  7) Change SOCKS proxy (IP / port)"
        c_hdr " 8) Egress mode       9) Update            10) Uninstall          0) Exit"
        case "$(ask "select")" in
            1) cmd_enable || true;;
            2) cmd_disable || true;;
            3) local n s p u pw
               n=$(ask "client name (a-z 0-9 -)"); s=$(ask "SNI for this client"); p=$(ask "local port" "$(suggest_port)")
               u=$(ask "username" "$n"); pw=$(ask "password (empty = random)")
               ( cmd_add "$n" "$s" "$p" "$u" "$pw" ) || true;;
            4) local n; n=$(pick_client) || continue
               [ "$(ask "remove '$n'? y/n" n)" = y ] && { ( cmd_remove "$n" ) || true; };;
            5) local n args=() v; n=$(pick_client) || continue
               ( load_client "$n"; echo "current: SNI=$SNI PORT=$PORT USER=$CUSER PASS=$CPASS" )
               v=$(ask "new SNI (empty = keep)"); [ -n "$v" ] && args+=("sni=$v")
               v=$(ask "new local port (empty = keep)"); [ -n "$v" ] && args+=("port=$v")
               v=$(ask "new username (empty = keep)"); [ -n "$v" ] && args+=("user=$v")
               v=$(ask "new password (empty = keep, 'random' = generate)"); [ "$v" = random ] && v=$(rand_pass); [ -n "$v" ] && args+=("pass=$v")
               [ "${#args[@]}" -gt 0 ] && { ( cmd_set "$n" "${args[@]}" ) || true; } || echo "nothing changed";;
            6) local n; n=$(pick_client) || continue; ( show_client "$n" ) || true;;
            7) load_global
               ( cmd_socks "$(ask "SOCKS5 IP / host" "$SOCKS_HOST")" "$(ask "SOCKS5 port" "$SOCKS_PORT")" ) || true;;
            8) ( cmd_egress "$(ask "egress mode: socks (via SOCKS5 proxy) or nat (direct from VPS)" socks)" ) || true;;
            9) ( cmd_update ) && exec /usr/local/bin/sstp || true;;
            10) cmd_uninstall; exit 0;;
            0|q|"") exit 0;;
            *) c_err "invalid choice";;
        esac
    done
}

installed || [ "${1:-}" = uninstall ] || [ "${1:-}" = update ] || die "vload-sstp is not installed (run install.sh)"
case "${1:-menu}" in
    menu)          menu;;
    list|status)   cmd_list;;
    enable)        cmd_enable;;
    disable)       cmd_disable;;
    add)           shift; cmd_add "$@";;
    set|adjust)    shift; cmd_set "$@";;
    remove|del)    shift; cmd_remove "$@";;
    show)          shift; show_client "${1:-}";;
    socks)         shift; cmd_socks "$@";;
    egress)        shift; cmd_egress "$@";;
    update)        cmd_update;;
    _reapply)      cmd_reapply;;
    uninstall)     shift; cmd_uninstall "$@";;
    _egress-run)   egress_run;;
    _egress-up)    egress_up;;
    _egress-down)  egress_down;;
    -h|--help|help) sed -n '2,15p' "$0";;
    *) die "unknown command: $1 (try: sstp help)";;
esac
